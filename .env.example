# ============================================================
# Variables de entorno del proyecto (ejemplo)
# ------------------------------------------------------------
# Copiá este archivo a `.env` y ajustá los valores.
#   cp .env.example .env
# El `.env` real está ignorado por git.
# docker-compose funciona incluso sin `.env` (usa estos defaults).
# ============================================================

# ---------- MySQL: users-api ----------
MYSQL_USERS_ROOT_PASSWORD=root
USERS_DB_NAME=usersdb
USERS_DB_USER=user
USERS_DB_PASSWORD=userpass

# ---------- MySQL: rooms-api ----------
MYSQL_ROOMS_ROOT_PASSWORD=rootrooms
ROOMS_DB_NAME=roomsdb
ROOMS_DB_USER=roomsuser
ROOMS_DB_PASSWORD=roomspass

# ---------- MongoDB: reservations-api ----------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootpass

# ---------- RabbitMQ ----------
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ---------- JWT (compartido entre servicios) ----------
# En producción, usá un valor largo y aleatorio.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
