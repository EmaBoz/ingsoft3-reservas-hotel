server {
    listen 80;

    # El DNS y la dirección de cada microservicio llegan por variables de
    # entorno, que nginx reemplaza al arrancar (la imagen oficial procesa
    # /etc/nginx/templates/). Así la misma imagen sirve en QA y en PROD y cada
    # una le habla a sus propias apis. Los valores por defecto están en el
    # Dockerfile y son los nombres de servicio del compose.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    # SPA: estáticos, con fallback a index.html para las rutas del router
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # La app es una arquitectura de microservicios: cada prefijo de ruta se
    # reenvía al microservicio que lo atiende (mismo mapeo que el proxy de Vite
    # en desarrollo, vite.config.ts). Van en variables para que nginx resuelva
    # el nombre recién al llegar un pedido, no al arrancar.

    set $users_api ${USERS_API_URL};
    location /login {
        proxy_pass $users_api;
    }
    location /users {
        proxy_pass $users_api;
    }

    set $rooms_api ${ROOMS_API_URL};
    location /api/v1/ {
        proxy_pass $rooms_api;
    }

    set $reservations_api ${RESERVATIONS_API_URL};
    location /api/reservations {
        proxy_pass $reservations_api;
    }

    # Ojo: el frontend llama a /search-api/api/search/rooms y search-api expone
    # /api/search/rooms, sin ese prefijo (bug preexistente, ver decisiones.md TP2).
    set $search_api ${SEARCH_API_URL};
    location /search-api/ {
        proxy_pass $search_api;
    }
}
